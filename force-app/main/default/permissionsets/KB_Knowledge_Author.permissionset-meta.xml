<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Additive Knowledge write access for Fix-with-AI and merge: Knowledge__kav Create/Edit + article-authoring user perms. Assign on top of KB Assessment Manager only for users who should write drafts. No View All / Modify All.</description>
    <label>KB Knowledge Author</label>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Knowledge__kav</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <!--
      Field-level Read+Edit on the Knowledge__kav custom fields THE APP ITSELF
      SHIPS. Not the same as viewAllFields=true (which CLAUDE.md warns against
      as customer-visibility overreach) — this is targeted FLS on fields we
      deploy alongside this permset, needed by:
        - `Tier4ConsolidationAction` Golden-Record merges (Merged_Into__c
          links the merged loser to its survivor).
      Customer-specific Knowledge fields (Description__c, LongDescription__c,
      any other content-mapping target the customer selects in Setup) remain
      the customer's responsibility to wire up per the shipped guidance.
    -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Knowledge__kav.Merged_Into__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>EditKnowledge</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>ViewArchivedArticles</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>ViewDraftArticles</name>
    </userPermissions>
</PermissionSet>
