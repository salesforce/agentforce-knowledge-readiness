<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status__c</fullName>
    <description>Lifecycle status. Pending = awaiting action. Resolved = merged. Error = an approved merge failed (see Merge_Error__c for why) — the pair stays actionable so the user can fix the cause and retry. Not a Duplicate = human marked the pair as not a duplicate/conflict; soft / this-run-only — the pair is re-evaluated and can re-surface on the next assessment. Rejected / Suppressed = terminal discards (permanent; no longer written by the app, retained for older rows). Superseded = a different version of one of the linked articles was published outside the app's flow.</description>
    <externalId>false</externalId>
    <label>Status</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Pending</fullName>
                <default>true</default>
                <label>Pending</label>
            </value>
            <value>
                <fullName>Resolved</fullName>
                <default>false</default>
                <label>Resolved</label>
            </value>
            <value>
                <fullName>Error</fullName>
                <default>false</default>
                <label>Error</label>
            </value>
            <value>
                <fullName>Not a Duplicate</fullName>
                <default>false</default>
                <label>Not a Duplicate</label>
            </value>
            <value>
                <fullName>Rejected</fullName>
                <default>false</default>
                <label>Rejected</label>
            </value>
            <value>
                <fullName>Suppressed</fullName>
                <default>false</default>
                <label>Suppressed</label>
            </value>
            <value>
                <fullName>Superseded</fullName>
                <default>false</default>
                <label>Superseded</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
