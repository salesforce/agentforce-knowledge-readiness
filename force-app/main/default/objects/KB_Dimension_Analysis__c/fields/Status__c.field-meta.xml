<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status__c</fullName>
    <description>Lifecycle state for Issue records (parity with the prior KB_Recommendation__c.Status__c). Strength records use a default of Open and never transition.</description>
    <externalId>false</externalId>
    <inlineHelpText>Open = not yet reviewed. Queued = fix in progress. Resolved = successfully fixed. Error = fix attempt failed. Rejected = acknowledged, won't fix. Dismissed = (deprecated, use Rejected). Strength records remain Open.</inlineHelpText>
    <label>Status</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Open</fullName>
                <default>true</default>
                <label>Open</label>
            </value>
            <value>
                <fullName>Queued</fullName>
                <default>false</default>
                <label>Queued</label>
            </value>
            <value>
                <fullName>Resolved</fullName>
                <default>false</default>
                <label>Resolved</label>
            </value>
            <value>
                <fullName>Error</fullName>
                <default>false</default>
                <label>Error</label>
            </value>
            <value>
                <fullName>Dismissed</fullName>
                <default>false</default>
                <label>Dismissed</label>
            </value>
            <value>
                <fullName>Rejected</fullName>
                <default>false</default>
                <label>Rejected</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
